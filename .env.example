# Copy this file to ".env" and fill in your own values.
# Never commit .env: it holds your secret API key (it is already in .gitignore).

# Gemini API key, used by stages 1-3 and for handbook embeddings in stage 6.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Local LLM via Ollama, used by stages 4-6. Install from https://ollama.com,
# then run:  ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b

# How many times to try an LLM call before giving up
LLM_RETRY_MAX_ATTEMPTS=2
